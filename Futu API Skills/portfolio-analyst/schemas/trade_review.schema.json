    "tradePolicy": {"type": "object", "maxProperties": 7, "additionalProperties": false, "required": ["market_open_no_trade_minutes", "market_open_no_trade_minutes_by_market", "reentry_cooldown_minutes", "max_round_trips_per_symbol_day", "max_trades_per_day", "flag_add_to_loser", "flag_cost_proximity"], "properties": {"market_open_no_trade_minutes": {"type": ["integer", "null"], "minimum": 0}, "market_open_no_trade_minutes_by_market": {"type": "object", "maxProperties": 8, "propertyNames": {"enum": ["US", "HK", "CN", "SG", "MY", "JP", "CA", "AU"]}, "additionalProperties": {"type": "integer", "minimum": 0}}, "reentry_cooldown_minutes": {"type": ["integer", "null"], "minimum": 0}, "max_round_trips_per_symbol_day": {"type": ["integer", "null"], "minimum": 0}, "max_trades_per_day": {"type": ["integer", "null"], "minimum": 0}, "flag_add_to_loser": {"type": "boolean"}, "flag_cost_proximity": {"type": "boolean"}}},
