"}, "win_rate": {"$ref": "#/$defs/nullableDecimal"}, "average_win_base": {"$ref": "#/$defs/nullableDecimal"}, "average_loss_base": {"$ref": "#/$defs/nullableDecimal"}, "payoff_ratio_base": {"$ref": "#/$defs/nullableDecimal"}, "profit_factor_base": {"$ref": "#/$defs/nullableDecimal"}, "expectancy_base": {"$ref": "#/$defs/nullableDecimal"}, "same_day_reversals": {"$ref": "#/$defs/nullableCount"}, "same_day_reversal_rate": {"$ref": "#/$defs/nullableDecimal"}, "reentries_within_cooldown": {"$ref": "#/$defs/nullableCount"}, "open_window_trades": {"$ref": "#/$defs/nullableCount"}, "open_window_trade_rate": {"$ref": "#/$defs/nullableDecimal"}, "repeated_symbol_days": {"$ref": "#/$defs/nullableCount"}, "add_to_winner_count": {"$ref": "#/$defs/nullableCount"}, "add_to_loser_count": {"$ref": "#/$defs/nullableCount"}, "add_to_loser_rate": {"$ref": "#/$defs/nullableDecimal"}, "cost_proximity_exit_count": {"$ref": "#/$defs/nullableCount"}}},
