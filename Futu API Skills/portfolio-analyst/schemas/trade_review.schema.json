    "context": {"type": "object", "maxProperties": 2, "additionalProperties": false, "required": ["account_ref", "market"], "properties": {"account_ref": {"type": "string", "minLength": 1}, "market": {"enum": ["US", "HK", "CN", "SG", "MY", "JP", "CA", "AU"]}}},
    "failedContext": {"type": "object", "maxProperties": 3, "additionalProperties": false, "required": ["account_ref", "market", "reason"], "properties": {"account_ref": {"type": "string", "minLength": 1}, "market": {"enum": ["US", "HK", "CN", "SG", "MY", "JP", "CA", "AU"]}, "reason": {"type": "string", "minLength": 1}}},
    "order": {"type": "object", "maxProperties": 12, "additionalProperties": false, "required": ["order_id", "account_ref", "identity", "market", "currency", "side", "status", "quantity", "dealt_quantity", "price", "created_at", "updated_at"], "properties": {"order_id": {"type": "string", "minLength": 1}, "account_ref": {"type": "string", "minLength": 1}, "identity": {"$ref": "#/$defs/identity"}, "market": {"enum": ["US", "HK", "CN", "SG", "MY", "JP", "CA", "AU"]}, "currency": {"$ref": "#/$defs/currency"}, "side": {"enum": ["BUY", "SELL"]}, "status": {"enum": ["WAITING_SUBMIT", "SUBMITTING", "SUBMITTED", "FILLED_PART", "FILLED_ALL", "CANCELLED_PART", "CANCELLED_ALL", "FAILED", "DISABLED", "DELETED"]}, "quantity": {"$ref": "#/$defs/positiveDecimal"}, "dealt_quantity": {"$ref": "#/$defs/decimal"}, "price": {"$ref": "#/$defs/positiveDecimal"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}}},
    "fill": {"type": "object", "maxProperties": 13, "additionalProperties": false, "required": ["deal_id", "order_id", "account_ref", "identity", "market", "currency", "fx_to_base", "side", "quantity", "price", "executed_at", "exchange_timezone", "event_type"], "properties": {"deal_id": {"type": "string", "minLength": 1}, "order_id": {"type": "string", "minLength": 1}, "account_ref": {"type": "string", "minLength": 1}, "identity": {"$ref": "#/$defs/identity"}, "market": {"enum": ["US", "HK", "CN", "SG", "MY", "JP", "CA", "AU"]}, "currency": {"$ref": "#/$defs/currency"}, "fx_to_base": {"oneOf": [{"$ref": "#/$defs/positiveDecimal"}, {"type": "null"}]}, "side": {"enum": ["BUY", "SELL"]}, "quantity": {"$ref": "#/$defs/positiveDecimal"}, "price": {"$ref": "#/$defs/positiveDecimal"}, "executed_at": {"type": "string", "format": "date-time"}, "exchange_timezone": {"type": "string", "minLength": 1}, "event_type": {"enum": ["TRADE", "CORPORATE_ACTION", "TRANSFER", "COST_ADJUSTMENT"]}}},
    "orderGroup": {"type": "object", "maxProperties": 11, "additionalProperties": false, "required": ["group_ref", "account_ref", "order_id", "identity", "side", "quantity", "average_price", "fill_count", "effective_at", "first_fill_at", "last_fill_at"], "properties": {"group_ref": {"type": "string", "minLength": 3}, "account_ref": {"type": "string"}, "order_id": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "side": {"enum": ["BUY", "SELL"]}, "quantity": {"$ref": "#/$defs/decimal"}, "average_price": {"$ref": "#/$defs/decimal"}, "fill_count": {"type": "integer", "minimum": 1}, "effective_at": {"type": "string", "format": "date-time"}, "first_fill_at": {"type": "string", "format": "date-time"}, "last_fill_at": {"type": "string", "format": "date-time"}}},
    "roundTrip": {"type": "object", "maxProperties": 11, "additionalProperties": false, "required": ["account_ref", "identity", "currency", "quantity", "entry_price", "exit_price", "opened_at", "closed_at", "realized_pl_local", "realized_pl_base", "holding_seconds"], "properties": {"account_ref": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "currency": {"$ref": "#/$defs/currency"}, "quantity": {"$ref": "#/$defs/decimal"}, "entry_price": {"$ref": "#/$defs/decimal"}, "exit_price": {"$ref": "#/$defs/decimal"}, "opened_at": {"type": "string", "format": "date-time"}, "closed_at": {"type": "string", "format": "date-time"}, "realized_pl_local": {"$ref": "#/$defs/decimal"}, "realized_pl_base": {"$ref": "#/$defs/nullableDecimal"}, "holding_seconds": {"$ref": "#/$defs/decimal"}}},
