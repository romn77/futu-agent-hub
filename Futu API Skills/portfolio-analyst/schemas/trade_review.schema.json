    "behaviorFinding": {"type": "object", "maxProperties": 8, "additionalProperties": false, "required": ["type", "severity", "evidence", "verified", "affected_events", "affected_symbols", "period_start", "period_end"], "properties": {"type": {"enum": ["SAME_DAY_REVERSAL", "SELL_THEN_REENTRY", "MARKET_OPEN_ACTIVITY", "REENTRY_WITHIN_COOLDOWN", "EARLY_SESSION_TRADING", "REPEATED_SYMBOL_ACTIVITY", "ADD_TO_WINNER", "ADD_TO_LOSER"]}, "severity": {"enum": ["INFORMATIONAL", "MEDIUM"]}, "evidence": {"type": "string", "minLength": 1}, "verified": {"const": true}, "affected_events": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "affected_symbols": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}, "period_start": {"type": "string", "format": "date-time"}, "period_end": {"type": "string", "format": "date-time"}}},
    "qualityIssue": {"type": "object", "maxProperties": 2, "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"enum": ["CONTEXT_FAILED", "CONTEXT_OMITTED_BUDGET", "CURRENT_SESSION_INCOMPLETE", "CORPORATE_ACTION_EVIDENCE_UNSUPPORTED", "NONTRADE_EVENTS_EXCLUDED", "ORPHAN_FILL", "ORDER_MISSING_FILLS", "ORDER_FILL_QTY_MISMATCH", "ORDER_STATUS_CONFLICT", "UNMATCHED_SELL", "BASE_MONETARY_FX_INCOMPLETE", "BASE_REALIZED_PNL_FX_INCOMPLETE", "FEES_UNAVAILABLE", "SOURCE_UNAVAILABLE", "ANALYSIS_BUDGET_EXCEEDED", "SOURCE_HISTORY_ROW_CAP", "REENTRY_POLICY_UNCONFIGURED", "OPEN_WINDOW_POLICY_UNCONFIGURED", "TURNOVER_SNAPSHOT_NAV"]}, "detail": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "maxProperties": 9, "additionalProperties": false, "required": ["orders_command", "deals_command", "timezone_basis", "monetary_basis", "realized_pl_basis", "orders_option_policy", "deals_option_policy"], "properties": {"orders_command": {"const": "get_history_orders"}, "deals_command": {"const": "get_history_order_fill_list"}, "timezone_basis": {"const": "EXCHANGE_LOCAL"}, "monetary_basis": {"const": "LOCAL_CURRENCY_BUCKETS_BASE_IDENTITY_PNL_AND_VERIFIED_SNAPSHOT_FX"}, "realized_pl_basis": {"const": "GROSS_PRE_FEE"}, "orders_option_policy": {"const": "acc-id,market,trd-env,start,end,security-firm,ctx-type,limit=200,json"}, "deals_option_policy": {"const": "acc-id,market,trd-env,start,end,security-firm,ctx-type,json"}, "audited_source_version": {"type": "string"}, "audited_source_digests": {"type": "object", "maxProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
