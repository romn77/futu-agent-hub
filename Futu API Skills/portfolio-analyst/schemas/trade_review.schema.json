{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-analyst.local/schemas/trade_review.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "review_id", "source", "start", "end", "coverage", "order_groups", "round_trips", "open_lots", "metrics", "policy_status", "policy_checks", "findings", "motive_status", "data_quality_status", "data_quality_notes", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"}, "review_id": {"type": "string", "pattern": "^tr_[0-9a-f]{16}$"},
    "source": {"const": "futuapi"}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["orders_received", "deals_received", "source_snapshot_id"], "properties": {"orders_received": {"type": "integer", "minimum": 0}, "deals_received": {"type": "integer", "minimum": 0}, "source_snapshot_id": {"type": ["string", "null"]}}},
    "order_groups": {"type": "array", "items": {"$ref": "#/$defs/orderGroup"}},
    "round_trips": {"type": "array", "items": {"$ref": "#/$defs/roundTrip"}},
    "open_lots": {"type": "array", "items": {"$ref": "#/$defs/openLot"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "policy_status": {"enum": ["UNCONFIGURED", "PASS", "BREACH"]},
    "policy_checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "observed", "limit", "status"], "properties": {"name": {"type": "string"}, "observed": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 0}, "status": {"enum": ["PASS", "BREACH"]}}}},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "motive_status": {"const": "UNVERIFIED"},
    "data_quality_status": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "ERROR"]}, "data_quality_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["orders_command", "deals_command", "timezone_basis"], "properties": {"orders_command": {"const": "get_history_orders"}, "deals_command": {"const": "get_history_order_fill_list"}, "timezone_basis": {"const": "EXCHANGE_LOCAL"}}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "nullableDecimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "identity": {"type": "string", "pattern": "^[A-Z]{2,4}\\.[A-Z0-9]+(?:[.-][A-Z0-9]+)*$"},
    "orderGroup": {"type": "object", "additionalProperties": false, "required": ["account_ref", "order_id", "identity", "side", "quantity", "average_price", "fill_count", "first_fill_at", "last_fill_at"], "properties": {"account_ref": {"type": "string"}, "order_id": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "side": {"enum": ["BUY", "SELL"]}, "quantity": {"$ref": "#/$defs/decimal"}, "average_price": {"$ref": "#/$defs/decimal"}, "fill_count": {"type": "integer", "minimum": 1}, "first_fill_at": {"type": "string", "format": "date-time"}, "last_fill_at": {"type": "string", "format": "date-time"}}},
    "roundTrip": {"type": "object", "additionalProperties": false, "required": ["account_ref", "identity", "quantity", "entry_price", "exit_price", "opened_at", "closed_at", "realized_pl", "holding_seconds"], "properties": {"account_ref": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "quantity": {"$ref": "#/$defs/decimal"}, "entry_price": {"$ref": "#/$defs/decimal"}, "exit_price": {"$ref": "#/$defs/decimal"}, "opened_at": {"type": "string", "format": "date-time"}, "closed_at": {"type": "string", "format": "date-time"}, "realized_pl": {"$ref": "#/$defs/decimal"}, "holding_seconds": {"$ref": "#/$defs/decimal"}}},
    "openLot": {"type": "object", "additionalProperties": false, "required": ["account_ref", "identity", "quantity", "price", "opened_at"], "properties": {"account_ref": {"type": "string"}, "identity": {"$ref": "#/$defs/identity"}, "quantity": {"$ref": "#/$defs/decimal"}, "price": {"$ref": "#/$defs/decimal"}, "opened_at": {"type": "string", "format": "date-time"}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["trade_count", "order_count", "fill_count", "distinct_symbols", "buy_notional", "sell_notional", "portfolio_turnover", "per_symbol_turnover", "average_holding_seconds", "median_holding_seconds", "closed_trips", "win_rate", "average_win", "average_loss", "payoff_ratio", "profit_factor", "expectancy", "same_day_reversals", "same_day_reversal_rate", "reentries_within_cooldown", "open_window_trades", "open_window_trade_rate", "repeated_symbol_days", "add_to_winner_count", "add_to_loser_count", "add_to_loser_rate", "cost_proximity_exit_count"], "properties": {"trade_count": {"type": "integer", "minimum": 0}, "order_count": {"type": "integer", "minimum": 0}, "fill_count": {"type": "integer", "minimum": 0}, "distinct_symbols": {"type": "integer", "minimum": 0}, "buy_notional": {"$ref": "#/$defs/decimal"}, "sell_notional": {"$ref": "#/$defs/decimal"}, "portfolio_turnover": {"$ref": "#/$defs/nullableDecimal"}, "per_symbol_turnover": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}, "average_holding_seconds": {"$ref": "#/$defs/nullableDecimal"}, "median_holding_seconds": {"$ref": "#/$defs/nullableDecimal"}, "closed_trips": {"type": "integer", "minimum": 0}, "win_rate": {"$ref": "#/$defs/nullableDecimal"}, "average_win": {"$ref": "#/$defs/nullableDecimal"}, "average_loss": {"$ref": "#/$defs/nullableDecimal"}, "payoff_ratio": {"$ref": "#/$defs/nullableDecimal"}, "profit_factor": {"$ref": "#/$defs/nullableDecimal"}, "expectancy": {"$ref": "#/$defs/nullableDecimal"}, "same_day_reversals": {"type": "integer", "minimum": 0}, "same_day_reversal_rate": {"$ref": "#/$defs/nullableDecimal"}, "reentries_within_cooldown": {"type": "integer", "minimum": 0}, "open_window_trades": {"type": "integer", "minimum": 0}, "open_window_trade_rate": {"$ref": "#/$defs/nullableDecimal"}, "repeated_symbol_days": {"type": "integer", "minimum": 0}, "add_to_winner_count": {"type": ["integer", "null"], "minimum": 0}, "add_to_loser_count": {"type": ["integer", "null"], "minimum": 0}, "add_to_loser_rate": {"$ref": "#/$defs/nullableDecimal"}, "cost_proximity_exit_count": {"type": ["integer", "null"], "minimum": 0}}}
  }
}
