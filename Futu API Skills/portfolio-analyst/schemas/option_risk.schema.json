{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-analyst.local/schemas/option_risk.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "option_risk_id", "analysis_now", "as_of", "source_snapshot_id", "source_snapshot_digest", "base_currency", "status", "data_quality", "coverage", "provenance", "source_population", "quote_evidence", "leg_exposures", "greek_aggregates", "option_type_buckets", "expiry_buckets", "quality_reasons", "formulas", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "option_risk_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "analysis_now": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "source_snapshot_id": {"type": "string", "pattern": "^ps-[0-9]{8}T[0-9]{6}Z-(real|simulate)-[a-z]{3}-[0-9a-f]{16}$"},
    "source_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "status": {"enum": ["NOT_APPLICABLE", "COMPLETE", "PARTIAL", "UNAVAILABLE", "FUTURE_SNAPSHOT"]},
    "data_quality": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "freshness"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "freshness": {"const": "UNVERIFIED"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["source_positions", "nonzero_positions", "unknown_security_type_positions", "option_legs", "unique_contracts", "supported_contracts", "selected_contracts", "quoted_contracts", "unsupported_contracts", "budget_omitted_contracts"],
      "properties": {
        "source_positions": {"type": "integer", "minimum": 0, "maximum": 10000},
        "nonzero_positions": {"type": "integer", "minimum": 0, "maximum": 10000},
        "unknown_security_type_positions": {"type": "integer", "minimum": 0, "maximum": 10000},
        "option_legs": {"type": "integer", "minimum": 0, "maximum": 10000},
        "unique_contracts": {"type": "integer", "minimum": 0, "maximum": 10000},
        "supported_contracts": {"type": "integer", "minimum": 0, "maximum": 10000},
        "selected_contracts": {"type": "integer", "minimum": 0, "maximum": 30},
        "quoted_contracts": {"type": "integer", "minimum": 0, "maximum": 30},
        "unsupported_contracts": {"type": "integer", "minimum": 0, "maximum": 10000},
        "budget_omitted_contracts": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_snapshot", "quote_source", "quote_script_sha256", "quote_capability", "quote_freshness", "greek_unit"],
      "properties": {
        "source_snapshot": {"$ref": "https://portfolio-analyst.local/schemas/portfolio_snapshot.schema.json"},
        "quote_source": {"const": "OFFICIAL_FUTUAPI_GET_OPTION_QUOTE"},
        "quote_script_sha256": {"const": "0ea054b6b8f6f37938885041b7257653627941408462fc9c3c53d0395d4c8fd8"},
        "quote_capability": {"enum": ["AVAILABLE", "UNAVAILABLE", "NOT_ACCESSED"]},
        "quote_freshness": {"const": "UNVERIFIED"},
        "greek_unit": {"const": "RAW_CONTRACT_UNITS_NO_MULTIPLIER"}
      }
    },
    "source_population": {
      "type": "object", "additionalProperties": false,
      "required": ["net_market_value_base", "gross_market_value_base", "gross_to_nav", "contracts"],
      "properties": {
        "net_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"},
        "gross_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"},
        "gross_to_nav": {"oneOf": [{"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"}, {"type": "null"}]},
        "contracts": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/contract"}}
      }
    },
    "quote_evidence": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/quoteEvidence"}},
    "leg_exposures": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/leg"}},
    "greek_aggregates": {
      "type": "object", "additionalProperties": false,
      "required": ["delta", "gamma", "vega", "theta", "rho"],
      "properties": {
        "delta": {"$ref": "#/$defs/greekAggregate"}, "gamma": {"$ref": "#/$defs/greekAggregate"},
        "vega": {"$ref": "#/$defs/greekAggregate"}, "theta": {"$ref": "#/$defs/greekAggregate"},
        "rho": {"$ref": "#/$defs/greekAggregate"}
      }
    },
    "option_type_buckets": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/typeBucket"}},
    "expiry_buckets": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/expiryBucket"}},
    "quality_reasons": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/reason"}},
    "formulas": {
      "type": "object", "additionalProperties": false,
      "required": ["leg_greek", "net_greek", "gross_abs_greek", "gross_to_nav", "dte"],
      "properties": {
        "leg_greek": {"type": "string", "maxLength": 256}, "net_greek": {"type": "string", "maxLength": 256},
        "gross_abs_greek": {"type": "string", "maxLength": 256}, "gross_to_nav": {"type": "string", "maxLength": 256},
        "dte": {"type": "string", "maxLength": 256}
      }
    },
    "limitations": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
  },
  "$defs": {
    "identity": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/positionIdentity"},
    "nullableDecimal": {"oneOf": [{"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"}, {"type": "null"}]},
    "greeks": {
      "type": "object", "additionalProperties": false,
      "required": ["delta", "gamma", "vega", "theta", "rho"],
      "properties": {"delta": {"$ref": "#/$defs/nullableDecimal"}, "gamma": {"$ref": "#/$defs/nullableDecimal"}, "vega": {"$ref": "#/$defs/nullableDecimal"}, "theta": {"$ref": "#/$defs/nullableDecimal"}, "rho": {"$ref": "#/$defs/nullableDecimal"}}
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "market", "gross_abs_market_value_base", "leg_count", "selection_status", "selection_rank"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"}, "market": {"type": "string", "minLength": 1, "maxLength": 8},
        "gross_abs_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"},
        "leg_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "selection_status": {"enum": ["SELECTED", "BUDGET_OMITTED", "UNSUPPORTED_MARKET"]},
        "selection_rank": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 10000}, {"type": "null"}]}
      }
    },
    "quoteResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "unit", "greeks", "option_type", "expiry", "strike", "implied_volatility"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"}, "unit": {"const": "RAW_CONTRACT_UNITS_NO_MULTIPLIER"},
        "greeks": {"$ref": "#/$defs/greeks"}, "option_type": {"enum": ["CALL", "PUT", null]},
        "expiry": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "strike": {"oneOf": [{"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"}, {"type": "null"}]},
        "implied_volatility": {"oneOf": [{"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"}, {"type": "null"}]}
      }
    },
    "quoteEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "selection_rank", "request", "freshness", "request_started_at", "request_finished_at", "outcome", "response"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"}, "selection_rank": {"type": "integer", "minimum": 1, "maximum": 30},
        "request": {"type": "object", "additionalProperties": false, "required": ["action", "quantity"], "properties": {"action": {"const": "BUY"}, "quantity": {"const": "1.0"}}},
        "freshness": {"const": "UNVERIFIED"}, "request_started_at": {"type": "string", "format": "date-time"},
        "request_finished_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["SUCCESS", "FAILED", "SOURCE_UNAVAILABLE", "CIRCUIT_OPEN", "WALL_BUDGET_OMITTED"]},
        "response": {"oneOf": [{"$ref": "#/$defs/quoteResponse"}, {"type": "null"}]}
      }
    },
    "leg": {
      "type": "object", "additionalProperties": false,
      "required": ["source_index", "identity", "market", "account_ref", "quantity", "direction", "market_value_base", "unit", "option_type", "expiry", "strike", "implied_volatility", "greeks"],
      "properties": {
        "source_index": {"type": "integer", "minimum": 0, "maximum": 9999}, "identity": {"$ref": "#/$defs/identity"},
        "market": {"type": "string", "minLength": 1, "maxLength": 8}, "account_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "quantity": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"},
        "direction": {"enum": ["LONG", "SHORT"]}, "market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"},
        "unit": {"const": "RAW_CONTRACT_UNITS_NO_MULTIPLIER"}, "option_type": {"enum": ["CALL", "PUT", null]},
        "expiry": {"oneOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
        "strike": {"$ref": "#/$defs/nullableDecimal"}, "implied_volatility": {"$ref": "#/$defs/nullableDecimal"},
        "greeks": {"$ref": "#/$defs/greeks"}
      }
    },
    "greekAggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "status", "net", "gross_abs", "coverage"],
      "properties": {
        "unit": {"const": "RAW_CONTRACT_UNITS_NO_MULTIPLIER"}, "status": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "net": {"$ref": "#/$defs/nullableDecimal"}, "gross_abs": {"$ref": "#/$defs/nullableDecimal"},
        "coverage": {"type": "object", "additionalProperties": false, "required": ["available_legs", "total_legs"], "properties": {"available_legs": {"type": "integer", "minimum": 0, "maximum": 10000}, "total_legs": {"type": "integer", "minimum": 0, "maximum": 10000}}}
      }
    },
    "typeBucket": {
      "type": "object", "additionalProperties": false, "required": ["option_type", "leg_count", "net_market_value_base", "gross_market_value_base"],
      "properties": {"option_type": {"enum": ["CALL", "PUT", "UNKNOWN"]}, "leg_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "net_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"}, "gross_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"}}
    },
    "expiryBucket": {
      "type": "object", "additionalProperties": false, "required": ["expiry", "dte_by_market", "leg_count", "identities", "net_market_value_base", "gross_market_value_base"],
      "properties": {"expiry": {"oneOf": [{"type": "string", "format": "date"}, {"const": "UNKNOWN"}]}, "dte_by_market": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["market", "dte", "expired"], "properties": {"market": {"enum": ["US", "HK"]}, "dte": {"type": "integer", "minimum": -100000, "maximum": 100000}, "expired": {"type": "boolean"}}}}, "leg_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "identities": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}, "net_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/decimal"}, "gross_market_value_base": {"$ref": "https://portfolio-analyst.local/schemas/report_defs.schema.json#/$defs/nonnegativeDecimal"}}
    },
    "reason": {
      "type": "object", "additionalProperties": false, "required": ["code", "scope", "detail"],
      "properties": {"code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}, "scope": {"type": "string", "minLength": 1, "maxLength": 128}, "detail": {"type": "string", "minLength": 1, "maxLength": 512}}
    }
  }
}
