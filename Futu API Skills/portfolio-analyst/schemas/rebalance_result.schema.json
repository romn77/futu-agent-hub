{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://portfolio-analyst.local/schemas/rebalance_result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "simulation_id", "source_snapshot_id", "as_of", "base_currency", "status", "execution_disabled", "feasible", "constraints", "before", "after", "changes", "risk_changes", "warnings", "data_quality_status", "coverage", "data_quality_notes"],
  "properties": {
    "schema_version": {"const": "1.1"}, "simulation_id": {"type": "string", "pattern": "^sim_[0-9a-f]{16}$"}, "source_snapshot_id": {"type": "string", "pattern": "^ps-"}, "as_of": {"type": "string", "format": "date-time"}, "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "status": {"const": "HYPOTHETICAL"}, "execution_disabled": {"const": true}, "feasible": {"type": "boolean"},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["allow_margin", "allow_short", "sell_only", "new_cash_only", "new_cash_base"], "properties": {"allow_margin": {"type": "boolean"}, "allow_short": {"type": "boolean"}, "sell_only": {"type": "boolean"}, "new_cash_only": {"type": "boolean"}, "new_cash_base": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}}},
    "before": {"$ref": "#/$defs/state"}, "after": {"$ref": "#/$defs/state"},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "operation", "value", "amount_delta_base", "quantity_delta"], "properties": {"symbol": {"type": "string"}, "operation": {"enum": ["TARGET_WEIGHT", "AMOUNT_DELTA", "SHARE_DELTA"]}, "value": {"$ref": "#/$defs/decimal"}, "amount_delta_base": {"$ref": "#/$defs/decimal"}, "quantity_delta": {"$ref": "#/$defs/decimal"}}}},
    "risk_changes": {"$ref": "#/$defs/riskChanges"}, "warnings": {"type": "array", "items": {"type": "string"}}, "data_quality_status": {"enum": ["COMPLETE", "PARTIAL"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["source_positions", "hypothetical_positions", "changes_requested", "changes_applied", "price_evidence", "fx_evidence", "source_data_quality_status"], "properties": {"source_positions": {"type": "integer", "minimum": 0}, "hypothetical_positions": {"type": "integer", "minimum": 0}, "changes_requested": {"type": "integer", "minimum": 0}, "changes_applied": {"type": "integer", "minimum": 0}, "price_evidence": {"type": "integer", "minimum": 0}, "fx_evidence": {"type": "integer", "minimum": 0}, "source_data_quality_status": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "ERROR"]}}},
    "data_quality_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}},
    "riskChanges": {"type": "object", "additionalProperties": false, "required": ["status", "top_1", "top_3", "top_5", "hhi", "concentration", "sector", "region", "theme_full", "theme_split"], "properties": {"status": {"enum": ["STRUCTURAL_ONLY", "STRUCTURAL_ONLY_SIGNED"]}, "top_1": {"$ref": "#/$defs/decimal"}, "top_3": {"$ref": "#/$defs/decimal"}, "top_5": {"$ref": "#/$defs/decimal"}, "hhi": {"$ref": "#/$defs/decimal"}, "concentration": {"$ref": "#/$defs/map"}, "sector": {"$ref": "#/$defs/map"}, "region": {"$ref": "#/$defs/map"}, "theme_full": {"$ref": "#/$defs/map"}, "theme_split": {"$ref": "#/$defs/map"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "nav_base", "cash_base", "cash_weight", "positions", "exposures", "concentration"], "properties": {"snapshot_id": {"type": "string"}, "nav_base": {"$ref": "#/$defs/decimal"}, "cash_base": {"$ref": "#/$defs/decimal"}, "cash_weight": {"$ref": "#/$defs/decimal"}, "positions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["quantity", "market_value_base", "weight"], "properties": {"quantity": {"$ref": "#/$defs/decimal"}, "market_value_base": {"$ref": "#/$defs/decimal"}, "weight": {"$ref": "#/$defs/decimal"}}}}, "exposures": {"type": "object", "additionalProperties": false, "required": ["sector", "region", "theme_full", "theme_split"], "properties": {"sector": {"$ref": "#/$defs/map"}, "region": {"$ref": "#/$defs/map"}, "theme_full": {"$ref": "#/$defs/map"}, "theme_split": {"$ref": "#/$defs/map"}}}, "concentration": {"type": "object", "additionalProperties": false, "required": ["top_1", "top_3", "top_5", "hhi"], "properties": {"top_1": {"$ref": "#/$defs/decimal"}, "top_3": {"$ref": "#/$defs/decimal"}, "top_5": {"$ref": "#/$defs/decimal"}, "hhi": {"$ref": "#/$defs/decimal"}}}}}
  }
}
