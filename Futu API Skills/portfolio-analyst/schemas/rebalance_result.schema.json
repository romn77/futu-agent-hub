{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://portfolio-analyst.local/schemas/rebalance_result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "simulation_id", "source_snapshot_id", "source_snapshot", "as_of", "base_currency", "status", "execution_disabled", "feasible", "constraints", "request", "evidence", "before", "after", "changes", "risk_changes", "warnings", "data_quality_status", "coverage", "data_quality_notes"],
  "properties": {
    "schema_version": {"const": "1.3"}, "simulation_id": {"type": "string", "pattern": "^sim_[0-9a-f]{16}$"}, "source_snapshot_id": {"type": "string", "pattern": "^ps-"}, "source_snapshot": {"$ref": "https://portfolio-analyst.local/schemas/portfolio_snapshot.schema.json"}, "as_of": {"type": "string", "format": "date-time"}, "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "status": {"const": "HYPOTHETICAL"}, "execution_disabled": {"const": true}, "feasible": {"type": "boolean"},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["allow_margin", "allow_short", "sell_only", "new_cash_only", "new_cash_base"], "properties": {"allow_margin": {"type": "boolean"}, "allow_short": {"type": "boolean"}, "sell_only": {"type": "boolean"}, "new_cash_only": {"type": "boolean"}, "new_cash_base": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}}},
    "request": {"$ref": "https://portfolio-analyst.local/schemas/rebalance_request.schema.json"},
    "evidence": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["unit_price_local", "currency", "fx_to_base", "fx_as_of", "fx_method", "sector", "region", "themes", "theme_allocation", "source_legs", "operation_allocation"], "properties": {"unit_price_local": {"$ref": "#/$defs/decimal"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "fx_to_base": {"$ref": "#/$defs/decimal"}, "fx_as_of": {"type": "string", "format": "date-time"}, "fx_method": {"const": "SOURCE_SNAPSHOT_CURRENT_VALUATION"}, "sector": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}, "themes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "theme_allocation": {"const": "FULL_AND_EQUAL_SPLIT"}, "operation_allocation": {"const": "PROPORTIONAL_SAME_DIRECTION_SOURCE_LEGS"}, "source_legs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["account_ref", "quantity", "market_value_base"], "properties": {"account_ref": {"type": "string", "minLength": 1}, "quantity": {"$ref": "#/$defs/decimal"}, "market_value_base": {"$ref": "#/$defs/decimal"}}}}}}},
    "before": {"$ref": "#/$defs/state"}, "after": {"$ref": "#/$defs/state"},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "operation", "value", "amount_delta_base", "quantity_delta", "unit_price_local", "fx_to_base", "leg_allocations"], "properties": {"symbol": {"type": "string"}, "operation": {"enum": ["TARGET_WEIGHT", "AMOUNT_DELTA", "SHARE_DELTA"]}, "value": {"$ref": "#/$defs/decimal"}, "amount_delta_base": {"$ref": "#/$defs/decimal"}, "quantity_delta": {"$ref": "#/$defs/decimal"}, "unit_price_local": {"$ref": "#/$defs/decimal"}, "fx_to_base": {"$ref": "#/$defs/decimal"}, "leg_allocations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["account_ref", "amount_delta_base", "quantity_delta"], "properties": {"account_ref": {"type": "string", "minLength": 1}, "amount_delta_base": {"$ref": "#/$defs/decimal"}, "quantity_delta": {"$ref": "#/$defs/decimal"}}}}}}},
    "risk_changes": {"$ref": "#/$defs/riskChanges"}, "warnings": {"type": "array", "items": {"type": "string"}}, "data_quality_status": {"enum": ["COMPLETE", "PARTIAL"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["source_positions", "hypothetical_positions", "changes_requested", "changes_applied", "price_evidence", "fx_evidence", "source_data_quality_status"], "properties": {"source_positions": {"type": "integer", "minimum": 0}, "hypothetical_positions": {"type": "integer", "minimum": 0}, "changes_requested": {"type": "integer", "minimum": 0}, "changes_applied": {"type": "integer", "minimum": 0}, "price_evidence": {"type": "integer", "minimum": 0}, "fx_evidence": {"type": "integer", "minimum": 0}, "source_data_quality_status": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE", "ERROR"]}}},
    "data_quality_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "nullableDecimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]}, "map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}},
    "exposureDimensions": {"type": "object", "additionalProperties": false, "required": ["sector", "region", "theme_full", "theme_split"], "properties": {"sector": {"$ref": "#/$defs/map"}, "region": {"$ref": "#/$defs/map"}, "theme_full": {"$ref": "#/$defs/map"}, "theme_split": {"$ref": "#/$defs/map"}}},
    "exposureViews": {"type": "object", "additionalProperties": false, "required": ["long", "short", "gross", "net"], "properties": {"long": {"$ref": "#/$defs/exposureDimensions"}, "short": {"$ref": "#/$defs/exposureDimensions"}, "gross": {"$ref": "#/$defs/exposureDimensions"}, "net": {"$ref": "#/$defs/exposureDimensions"}}},
    "concentration": {"type": "object", "additionalProperties": false, "required": ["top_1", "top_3", "top_5", "hhi"], "properties": {"top_1": {"$ref": "#/$defs/nullableDecimal"}, "top_3": {"$ref": "#/$defs/nullableDecimal"}, "top_5": {"$ref": "#/$defs/nullableDecimal"}, "hhi": {"$ref": "#/$defs/nullableDecimal"}}},
    "riskChanges": {"type": "object", "additionalProperties": false, "required": ["status", "top_1", "top_3", "top_5", "hhi", "concentration", "sector", "region", "theme_full", "theme_split", "exposure_views"], "properties": {"status": {"enum": ["STRUCTURAL_ONLY", "STRUCTURAL_ONLY_SIGNED"]}, "top_1": {"$ref": "#/$defs/nullableDecimal"}, "top_3": {"$ref": "#/$defs/nullableDecimal"}, "top_5": {"$ref": "#/$defs/nullableDecimal"}, "hhi": {"$ref": "#/$defs/nullableDecimal"}, "concentration": {"oneOf": [{"$ref": "#/$defs/concentration"}, {"type": "null"}]}, "sector": {"$ref": "#/$defs/map"}, "region": {"$ref": "#/$defs/map"}, "theme_full": {"$ref": "#/$defs/map"}, "theme_split": {"$ref": "#/$defs/map"}, "exposure_views": {"$ref": "#/$defs/exposureViews"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "nav_base", "cash_base", "cash_weight", "long_market_value_base", "short_market_value_base", "gross_exposure_base", "net_exposure_base", "long_weight", "short_weight", "gross_weight", "net_weight", "positions", "exposures", "exposure_views", "concentration_status", "concentration"], "properties": {"snapshot_id": {"type": "string"}, "nav_base": {"$ref": "#/$defs/decimal"}, "cash_base": {"$ref": "#/$defs/decimal"}, "cash_weight": {"$ref": "#/$defs/decimal"}, "long_market_value_base": {"$ref": "#/$defs/decimal"}, "short_market_value_base": {"$ref": "#/$defs/decimal"}, "gross_exposure_base": {"$ref": "#/$defs/decimal"}, "net_exposure_base": {"$ref": "#/$defs/decimal"}, "long_weight": {"$ref": "#/$defs/decimal"}, "short_weight": {"$ref": "#/$defs/decimal"}, "gross_weight": {"$ref": "#/$defs/decimal"}, "net_weight": {"$ref": "#/$defs/decimal"}, "positions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["quantity", "market_value_base", "weight"], "properties": {"quantity": {"$ref": "#/$defs/decimal"}, "market_value_base": {"$ref": "#/$defs/decimal"}, "weight": {"$ref": "#/$defs/decimal"}}}}, "exposures": {"$ref": "#/$defs/exposureDimensions"}, "exposure_views": {"$ref": "#/$defs/exposureViews"}, "concentration_status": {"enum": ["AVAILABLE", "UNAVAILABLE_SIGNED"]}, "concentration": {"$ref": "#/$defs/concentration"}}}
  }
}
