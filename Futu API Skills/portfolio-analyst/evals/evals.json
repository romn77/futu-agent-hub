{
  "skill_name": "portfolio-analyst",
  "schema_version": "1.0",
  "evals": [
    {
      "id": "comprehensive-many-holdings",
      "prompt": "全面分析我当前的美股账户。账户是 REAL/USD，有 37 个已成交非零持仓、现金，没有期权；其中 12 个持仓权重至少 5%。我没有要求保存，也没有要求调仓或推荐新股票。",
      "fixture": {
        "snapshot_position_count": 37,
        "held_options": false,
        "user_policy_supplied": false,
        "persistence_requested": false
      },
      "expected_behavior": [
        "Acquire one fresh REAL/USD snapshot and bind the whole report to its snapshot_id/as_of.",
        "List all 37 holdings and keep cash at portfolio level.",
        "Deep-research no more than eight names by default and disclose eligible omissions; keep full holding coverage.",
        "When no additional research skill is available, continue the original analysis without installing or treating skill absence itself as missing evidence.",
        "Use at most two automatically selected full valuation models by default, and do not invent unavailable research facts.",
        "Return one Markdown portfolio report in chat without option, recommendation, simulation, or persistence workflows."
      ],
      "assertions": [
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Scope and data time"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "One-line conclusion"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Overview"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Three principal risks"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Complete holdings table"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Selected deep research"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Macro impact"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Observations"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Data gaps and sources"},
        {"type": "equals", "target": "trace.snapshot.trd_env", "value": "REAL"},
        {"type": "equals", "target": "trace.snapshot.base_currency", "value": "USD"},
        {"type": "count_equals", "target": "trace.observations.holdings.symbols", "value": 37},
        {"type": "equals", "target": "trace.observations.deep_research.max_names", "value": 8},
        {"type": "equals", "target": "trace.observations.deep_research.eligible_omissions_disclosed", "value": true},
        {"type": "not_contains", "target": "trace.loaded_references", "value": "references/options-policy.md"},
        {"type": "not_contains", "target": "trace.executed_commands", "value": "--save"},
        {"type": "not_contains", "target": "trace.executed_commands", "value": "portfolio.py analyze"},
        {"type": "not_contains", "target": "response_markdown", "value": "ADD/HOLD/TRIM/EXIT"}
      ]
    },
    {
      "id": "conditional-options-degradation",
      "prompt": "分析我当前 REAL/USD 美股持仓。快照中有股票、ETF 和三个期权腿；当前期权工具有原始 Greeks 和到期日，但没有 multiplier、Call/Put、underlying 或 ITM/OTM。",
      "fixture": {
        "held_options": true,
        "option_tool_status": "COMPLETE",
        "missing_option_fields": ["multiplier", "right", "underlying", "moneyness"]
      },
      "expected_behavior": [
        "Load the options policy only after held options are identified.",
        "Use the same snapshot_id/as_of for holdings and option inventory.",
        "Preserve the current option tool's COMPLETE raw-Greek status and report its unit limitation.",
        "Record multiplier, underlying, and moneyness as separate analysis capability gaps while completing unaffected sections."
      ],
      "assertions": [
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Scope and data time"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "One-line conclusion"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Overview"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Three principal risks"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Complete holdings table"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Selected deep research"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Option risk"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Macro impact"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Observations"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Data gaps and sources"},
        {"type": "equals", "target": "trace.observations.options.reported_tool_status", "value": "COMPLETE"},
        {"type": "equals", "target": "trace.observations.options.analysis_gaps_disclosed", "value": true},
        {"type": "contains", "target": "trace.loaded_references", "value": "references/options-policy.md"},
        {"type": "equals", "target": "trace.observations.options.tool_status", "value": "COMPLETE"},
        {"type": "equals", "target": "trace.observations.options.unit_label", "value": "RAW_CONTRACT_UNITS_NO_MULTIPLIER"},
        {"type": "contains", "target": "trace.observations.options.capability_gaps", "value": "multiplier"},
        {"type": "contains", "target": "trace.observations.options.capability_gaps", "value": "underlying"},
        {"type": "contains", "target": "trace.observations.options.capability_gaps", "value": "moneyness"},
        {"type": "not_contains", "target": "response_markdown", "value": "covered call confirmed"},
        {"type": "equals", "target": "trace.observations.workflow.stop", "value": false}
      ]
    },
    {
      "id": "explicit-rebalance-request",
      "prompt": "分析我当前 REAL/USD 美股账户，并模拟把 US.AAPL 调整到 NAV 的 12%；只要一个情景，不保存，也不要推荐未持有股票。",
      "fixture": {
        "held_options": false,
        "target": {"symbol": "US.AAPL", "target_weight": "0.12"},
        "scenario_count_requested": 1,
        "persistence_requested": false
      },
      "expected_behavior": [
        "Load recommendation and rebalance-simulation references because the request is explicit and quantified.",
        "Run one non-executable simulation against the fresh bound snapshot.",
        "Disclose resulting weights, turnover, cash impact, assumptions, and unsupported costs.",
        "Do not persist, place orders, or propose unheld candidates."
      ],
      "assertions": [
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Scope and data time"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "One-line conclusion"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Overview"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Three principal risks"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Complete holdings table"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Selected deep research"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Macro impact"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Observations"},
        {"type": "contains", "target": "trace.observations.report.sections", "value": "Data gaps and sources"},
        {"type": "contains", "target": "trace.loaded_references", "value": "references/recommendation-policy.md"},
        {"type": "contains", "target": "trace.loaded_references", "value": "references/optional-workflows/rebalance-simulation.md"},
        {"type": "count_equals", "target": "trace.observations.simulation.scenarios", "value": 1},
        {"type": "equals", "target": "trace.observations.simulation.target_weight", "value": "0.12"},
        {"type": "not_contains", "target": "trace.executed_commands", "value": "place_order"},
        {"type": "not_contains", "target": "trace.executed_commands", "value": "--save"},
        {"type": "equals", "target": "trace.observations.unheld_candidates.count", "value": 0}
      ]
    }
  ]
}
